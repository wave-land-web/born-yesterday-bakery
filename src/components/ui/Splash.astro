---
import { getImage } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import sproutedRye from '../../assets/sprouted-rye.png'

// Creating multiple image file types causes multiple network requests to load each image
// For now, we are using WEBP only to reduce the number of requests
const { src: sproutedRyeImageWebp } = await getImage({
  src: sproutedRye,
  format: 'webp',
  quality: 75,
})
---

{/* The background loads only when the splash is shown (see script) */}
<dialog
  class="splash"
  aria-label="Welcome to Born Yesterday Bakery"
  data-background={sproutedRyeImageWebp}
>
  <div class="scrim"></div>
  <div class="splash-content">
    <Icon name="logo" role="img" aria-label="Born Yesterday Bakery" />
    <p>Sourdough baked goods made with local, organic & ancient grains in Maine</p>
    <div class="splash-ctas">
      <button type="button" class="site-cta" autofocus>
        Enter Site
      </button>
      <a href="https://bornyesterdaybakery.square.site/" class="site-cta">
        Order Now
      </a>
    </div>
    <div class="splash-icons">
      <a
        href="https://www.instagram.com/bornyesterdaybakery/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <Icon name="instagram" aria-hidden="true" />
      </a>
      <a href="mailto:bornyesterdaybakery@gmail.com" aria-label="Email">
        <Icon name="email" aria-hidden="true" />
      </a>
    </div>
  </div>
</dialog>

{/* Start the background download while the page is still loading, but only if the splash will show */}
<script is:inline>
  if (sessionStorage.getItem('user-closed-splash') !== 'true') {
    new Image().src = document.querySelector('.splash').dataset.background
  }
</script>

<style>
  /* Native <dialog> (modal via showModal()): fills the screen and fades in and out */
  .splash {
    height: 100vh;
    width: 100vw;
    max-height: none;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: inherit;
    background-color: transparent;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition:
      opacity var(--transition-long),
      display var(--transition-long) allow-discrete,
      overlay var(--transition-long) allow-discrete;
  }

  .splash[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  .splash::backdrop {
    background-color: transparent;
  }

  .splash .scrim {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background-color: var(--color-secondary-transparent);
    z-index: -1;
  }

  .splash-content {
    padding: 1rem;
    text-align: center;
  }

  .splash-content [data-icon='logo'] {
    width: clamp(100px, 80%, 375px);
    margin: 0 auto;
  }

  .splash-content p {
    max-width: 525px;
    margin: 0 auto 2rem;
    font-size: clamp(var(--size-xs), 5vw, var(--size-base));
    line-height: clamp(var(--size-sm), 8vw, var(--size-lg));
    color: var(--color-black);
  }

  .splash-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(var(--size-xs), 2vw, var(--size-base));
    margin-bottom: 2rem;
  }

  .splash-ctas .site-cta {
    font-size: clamp(var(--size-xs), 5vw, var(--size-base));
    color: var(--color-secondary);
    border: 2px solid var(--color-primary);
  }

  .splash-ctas button.site-cta:hover {
    color: var(--color-primary);
    background-color: transparent;
  }

  .splash-ctas a.site-cta {
    color: var(--color-primary);
    background-color: transparent;
  }

  .splash-ctas a.site-cta:hover {
    color: var(--color-secondary);
    background-color: var(--color-primary);
  }

  .splash-icons,
  .splash-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-icons {
    gap: var(--size-base);
  }

  .splash-icons [data-icon] {
    width: clamp(var(--size-base), 10vw, var(--size-lg));
  }

  .splash-icons a:hover [data-icon] {
    color: var(--color-primary);
  }
</style>

<script>
  /**
   * Handle show/hide of the splash screen
   */
  function handleSplashDisplay() {
    // Show splash only if the user hasn't closed it during this session
    if (sessionStorage.getItem('user-closed-splash') === 'true') return

    const splash = document.querySelector<HTMLDialogElement>('.splash')
    if (!splash) return

    // The modal dialog makes the page behind inert, focuses the first button and closes on Escape.
    // Show it once the background has loaded, so it doesn't fade in as a see-through scrim
    const background = new Image()
    const show = () => {
      splash.style.backgroundImage = `url(${background.src})`
      splash.showModal()
    }
    background.addEventListener('load', show, { once: true })
    background.addEventListener('error', show, { once: true })
    background.src = splash.dataset.background ?? ''

    // (On Click) - Close the splash screen
    splash.querySelectorAll('.site-cta').forEach((cta) => {
      cta.addEventListener('click', () => splash.close())
    })

    // (On Close, including Escape) - Remember the choice and move focus into the page
    splash.addEventListener('close', () => {
      sessionStorage.setItem('user-closed-splash', 'true')
      document.getElementById('main')?.focus({ preventScroll: true })
    })
  }

  // (On Load) - Show the splash screen
  document.addEventListener('DOMContentLoaded', handleSplashDisplay)
</script>
