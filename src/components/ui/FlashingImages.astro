---
// TODO: Make this component reusable by passing in the images as props
import { Picture } from 'astro:assets'
import sydMakingDoughOne from '../../assets/syd-making-dough-1.jpg'
import sydMakingDoughTwo from '../../assets/syd-making-dough-2.jpg'
import rawDoughOne from '../../assets/raw-dough-1.jpg'
import rawDoughTwo from '../../assets/raw-dough-2.jpg'
import sydOne from '../../assets/syd-1.jpg'
import sydTwo from '../../assets/syd-2.jpg'

// Images fill the column: full width on phones, a third of the 1024px container on desktop
const pictureProps = {
  formats: ['avif', 'webp'],
  widths: [400, 800, 1200],
  sizes: '(min-width: 1024px) 310px, (min-width: 768px) 30vw, calc(100vw - 4rem)',
}
---

<div class="flashing-images lsa no-repeat">
  <div class="image-container">
    <Picture class="image-one" src={sydMakingDoughOne} {...pictureProps} alt="Syd making dough" />
    <Picture class="image-two" src={sydMakingDoughTwo} {...pictureProps} alt="Syd making dough" />
  </div>
  <div class="image-container">
    <Picture class="image-one" src={sydOne} {...pictureProps} alt="Syd baking" />
    <Picture class="image-two" src={sydTwo} {...pictureProps} alt="Syd baking and smiling" />
  </div>
  <div class="image-container">
    <Picture class="image-one" src={rawDoughOne} {...pictureProps} alt="Raw dough on a rack" />
    <Picture class="image-two" src={rawDoughTwo} {...pictureProps} alt="Raw dough on a rack" />
  </div>
</div>

<style>
  .flashing-images {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 4rem;
    padding: 1rem;
    background-color: var(--color-secondary);
    box-shadow: var(--box-shadow-normal);
    border-radius: var(--border-radius-image);
  }

  @media (min-width: 768px) {
    .flashing-images {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .image-container {
    height: clamp(150px, 50vw, 225px);
    position: relative;
    background-color: var(--color-grey-light);
    border-radius: var(--border-radius-image);
  }

  .image-container .image-one,
  .image-container .image-two {
    position: absolute;
    top: 0;
    transition: opacity var(--transition-long);
    box-shadow: var(--box-shadow-normal);
  }

  .image-container .image-two,
  .image-container:hover .image-one,
  .image-container.active .image-one {
    opacity: 0;
  }

  .image-container:hover .image-two,
  .image-container.active .image-two {
    opacity: 1;
  }

  .image-container img {
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const images = document.querySelectorAll('.image-container')
  const phone = window.matchMedia('(max-width: 767px)')

  /**
   * On phones, swap to the second image while each pair is in the middle of the screen
   */
  if (window.IntersectionObserver) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => entry.target.classList.toggle('active', entry.isIntersecting))
      },
      { rootMargin: '-25%', threshold: 0.1 },
    )

    // Only watch on phones; reset the images when switching to the desktop layout
    const watch = () => {
      if (phone.matches) return images.forEach((image) => observer.observe(image))
      observer.disconnect()
      images.forEach((image) => image.classList.remove('active'))
    }
    watch()
    phone.addEventListener('change', watch)
  }
</script>
